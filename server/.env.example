# Local Docker PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journal_dev
# Set true only when your database provider requires an external TLS connection.
# For a Render service using Render's Internal Database URL, leave this false.
DATABASE_SSL=false
SESSION_SECRET=your-session-secret-change-in-production
# Production example. Use exact HTTPS origins with no trailing slash or /api path.
# CLIENT_ORIGIN=https://your-vercel-project.vercel.app
# SERVER_ORIGIN=https://journal-d6mt.onrender.com
# AUTH_CALLBACK_ORIGIN=https://your-vercel-project.vercel.app
CLIENT_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:3001
AUTH_CALLBACK_ORIGIN=http://localhost:3001
PORT=3001
NODE_ENV=development

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- Resend Email Configuration ---
# Never commit a real Resend API key here. Use placeholders only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_PROVIDER=resend
# Set false in development to skip actual sending (logs "skipped" instead).
EMAIL_ENABLED=true
EMAIL_FROM_NAME=Asgard Publications
EMAIL_FROM_ADDRESS=no-reply@example-journal.org
EMAIL_REPLY_TO=
# Public origin used to build links (verification, reset, etc.) inside emails.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Token lifetimes.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
