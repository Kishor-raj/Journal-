# Local Docker PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journal_dev
# Set true only when your database provider requires an external TLS connection.
# For a Render service using Render's Internal Database URL, leave this false.
DATABASE_SSL=false
SESSION_SECRET=your-session-secret-change-in-production
# Production example. Use exact HTTPS origins with no trailing slash or /api path.
# CLIENT_ORIGIN=https://ijidcr-asgard.vercel.app
# SERVER_ORIGIN=https://journal-api.onrender.com
# AUTH_CALLBACK_ORIGIN=https://ijidcr-asgard.vercel.app
CLIENT_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:3001
AUTH_CALLBACK_ORIGIN=http://localhost:3001
PORT=3001
NODE_ENV=development

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- Resend Email Configuration ---
# Never commit a real Resend API key here. Use placeholders only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_PROVIDER=resend
# Set false in development to skip actual sending (logs "skipped" instead).
EMAIL_ENABLED=true
EMAIL_FROM_NAME=Asgard Publications
EMAIL_FROM_ADDRESS=no-reply@example-journal.org
EMAIL_REPLY_TO=
# Public origin used to build links (verification, reset, etc.) inside emails.
# In a split deployment (API on Render, frontend on Vercel) this MUST be the
# FRONTEND origin, e.g. https://ijidcr-asgard.vercel.app, never the API URL.
# On your own Hostinger server, point it at http://localhost:<port> during dev
# and at your real domain (e.g. https://www.ijidcr-asgard.in) in production.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Token lifetimes.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Background Email Worker / Scheduler ---
# Set BACKGROUND_JOBS_ENABLED=false to disable the worker and scheduler entirely.
# EMAIL_WORKER_INTERVAL_MS controls how often queued/failed emails are retried.
# DRAFT_REMINDER_ENABLED=false disables only the draft-reminder scheduler.
# DRAFT_REMINDER_INTERVAL_MS controls how often the scheduler checks for drafts.
# DRAFT_REMINDER_AFTER_DAYS = how many days a draft sits untouched before a reminder.
# DRAFT_REMINDER_COOLDOWN_DAYS = min days between reminders for the same manuscript.
BACKGROUND_JOBS_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=30000
DRAFT_REMINDER_ENABLED=true
DRAFT_REMINDER_INTERVAL_MS=21600000
DRAFT_REMINDER_AFTER_DAYS=3
DRAFT_REMINDER_COOLDOWN_DAYS=7

# --- Hostinger Mail Integration (AI Email System) ---
HOSTINGER_MAIL_API_KEY=
HOSTINGER_MAILBOX=editor@yourdomain.com
HOSTINGER_WEBHOOK_SECRET=
HOSTINGER_API_BASE_URL=https://email.hostinger.com/api/v1
WEBHOOK_EVENT_WORKER_INTERVAL_MS=15000

# --- Gemini AI Configuration ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- AI Email Worker ---
AI_EMAIL_WORKER_INTERVAL_MS=20000

# --- AI Email Operational Controls ---
AI_EMAIL_ENABLED=true
AI_AUTO_REPLY_ENABLED=true
AI_AUTO_REPLY_CONFIDENCE_THRESHOLD=0.90
AI_ROLLOUT_STAGE=development
AI_WEBHOOK_RATE_LIMIT=30
AI_DATA_RETENTION_DAYS=90
